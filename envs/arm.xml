<mujoco model="arm">

  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="RK4"/>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <light pos="2 2 2" dir="-1 -1 -1" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.75 0.75 0.75 1"/>

    <body name="base" pos="0 0 0">
      <inertial pos="0 0 0.05" mass="1.0" diaginertia="0.01 0.01 0.01"/>
      <geom type="cylinder" size="0.06 0.05" pos="0 0 0.05" rgba="0.3 0.3 0.3 1"/>
      <joint name="joint0" type="hinge" axis="0 0 1"
             range="-3.14159 3.14159" limited="true" damping="1.0" armature="0.1"/>

      <body name="link1" pos="0 0 0.1">
        <inertial pos="0 0 0.14" mass="0.8" diaginertia="0.008 0.008 0.002"/>
        <geom type="capsule" size="0.035" fromto="0 0 0 0 0 0.28" rgba="0.7 0.25 0.25 1"/>
        <joint name="joint1" type="hinge" axis="0 1 0"
               range="-1.8 1.8" limited="true" damping="1.0" armature="0.1"/>

        <body name="link2" pos="0 0 0.28">
          <inertial pos="0 0 0.12" mass="0.5" diaginertia="0.004 0.004 0.001"/>
          <geom type="capsule" size="0.028" fromto="0 0 0 0 0 0.24" rgba="0.25 0.65 0.25 1"/>
          <joint name="joint2" type="hinge" axis="0 1 0"
                 range="-2.4 2.4" limited="true" damping="1.0" armature="0.1"/>

          <body name="ee" pos="0 0 0.24">
            <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
            <geom type="sphere" size="0.022" rgba="0.9 0.1 0.1 1"/>
            <site name="ee_site" pos="0 0 0" size="0.015" rgba="1 1 0 1"/>
          </body>

        </body>
      </body>
    </body>

    <!-- Mocap target: moved by env each step, no collision -->
    <body name="target" pos="0 0.35 0.72" mocap="true">
      <geom type="sphere" size="0.035"
            rgba="0.1 0.9 0.1 0.6"
            contype="0" conaffinity="0"/>
      <site name="target_site" pos="0 0 0" size="0.01"/>
    </body>

  </worldbody>

  <actuator>
    <motor name="act0" joint="joint0" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="act1" joint="joint1" gear="60" ctrllimited="true" ctrlrange="-1 1"/>
    <motor name="act2" joint="joint2" gear="40" ctrllimited="true" ctrlrange="-1 1"/>
  </actuator>

</mujoco>